# Set your command prefix here.
# Leave it blank (PREFIX=) to allow all messages starting with letters/numbers to trigger commands.
# Example: PREFIX=! or PREFIX=#
PREFIX=!

# Paste your Baileys session creds.json content here as a single line
# Only use this if you're not using session/creds.json from a previous login
# Remove this line if you want to scan a QR instead
SESSION_ID={"creds":{"noiseKey":{"private":"xxx","public":"xxx"},"signedPreKey":{...}}}
